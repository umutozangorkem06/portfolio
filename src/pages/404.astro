---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found — Umut Ozan Gorkem" noindex>
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-6 py-20">
    <p
      class="text-[13px] font-semibold uppercase tracking-[0.14em] text-[color:var(--color-accent)]"
    >
      404
    </p>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight sm:text-[28px]">
      This page doesn&rsquo;t exist.
    </h1>
    <p class="mt-4 text-[16px] leading-7 text-[color:var(--color-text-muted)]">
      The link may be broken or the page may have moved.
    </p>
    <p class="mt-8 text-[15px]">
      <a class="prose-link" href="/">&larr; Back to the homepage</a>
    </p>
  </main>
</Base>
